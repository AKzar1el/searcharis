---
const language = "sl";
const heading = "Potovalni vodnik";
---
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="index,follow" />
    <title>Atlas vodnik | Slovensko</title>
    <link rel="canonical" href="https://fixtures.invalid/sl/" />
    <link rel="alternate" hreflang="en" href="https://fixtures.invalid/en/" />
    <link rel="alternate" hreflang="sl" href="https://fixtures.invalid/sl/" />
    <link rel="alternate" hreflang="x-default" href="https://fixtures.invalid/en/" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      name: "Atlas vodnik",
    })} />
  </head>
  <body><main><h1>{heading}</h1><p>Static Slovenian page.</p></main></body>
</html>
